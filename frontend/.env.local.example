# =============================================================================
# ACREDIA — Frontend environment (example)
#
# Copy to `.env.local` and fill in real values:   cp .env.local.example .env.local
#
# RULES
#   • NEXT_PUBLIC_*  → compiled into the browser bundle. NEVER put a secret here.
#   • everything else → server-only (API routes, workers). Keep it out of the client.
#   • NEXT_PUBLIC_* values are baked in at BUILD time, so change them and rebuild.
#   • On a host (Vercel etc.) set these in the project's env settings, not in a file.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. REQUIRED — Supabase (auth + database)
# -----------------------------------------------------------------------------
# Project URL and anon key: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-side only. Bypasses RLS — never expose as NEXT_PUBLIC_*.
# Needed by: admin routes, student provisioning, verification logging, workers.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key


# -----------------------------------------------------------------------------
# 2. REQUIRED — Stellar network
# -----------------------------------------------------------------------------
# One of: testnet | mainnet | custom
# This is the single switch for going live later. `custom` requires every
# NEXT_PUBLIC_* endpoint below to be set explicitly.
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Legacy alias for NEXT_PUBLIC_STELLAR_NETWORK (kept for backwards compatibility).
NEXT_PUBLIC_CHAIN_ID=testnet

# Optional for testnet/mainnet — sensible defaults are applied per network.
# Required only when NEXT_PUBLIC_STELLAR_NETWORK=custom.
NEXT_PUBLIC_NETWORK_NAME=testnet
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# NEXT_PUBLIC_STELLAR_EXPLORER_BASE_URL=https://stellar.expert/explorer/testnet


# -----------------------------------------------------------------------------
# 3. REQUIRED — Soroban contract
# -----------------------------------------------------------------------------
# Acredia uses ONE unified AcrediaCredential contract for issuance, registry
# lookups, authorization and revocation — both variables point at the same ID.
NEXT_PUBLIC_CREDENTIAL_NFT_CONTRACT=CD7WU5XRV4KDGKMLDB2IYSCRMMH5FEM45XI235XEFAO6AS2TS7BPSIZH
NEXT_PUBLIC_CREDENTIAL_REGISTRY_CONTRACT=CD7WU5XRV4KDGKMLDB2IYSCRMMH5FEM45XI235XEFAO6AS2TS7BPSIZH

# Same contract ID, read by the off-chain indexer script (scripts/indexer.ts).
NEXT_PUBLIC_CREDENTIAL_NFT_CONTRACT_ID=CD7WU5XRV4KDGKMLDB2IYSCRMMH5FEM45XI235XEFAO6AS2TS7BPSIZH


# -----------------------------------------------------------------------------
# 4. REQUIRED — IPFS storage (Pinata)
# -----------------------------------------------------------------------------
# Server-only JWT used by the /api/ipfs/* routes to pin files and metadata.
# ⚠️  Never name this NEXT_PUBLIC_PINATA_JWT — the app refuses to boot if a
#     server secret is exposed through a NEXT_PUBLIC_* variable.
PINATA_JWT=your_pinata_jwt_token

# Public read gateway (safe in the browser).
NEXT_PUBLIC_PINATA_GATEWAY=https://gateway.pinata.cloud


# -----------------------------------------------------------------------------
# 5. REQUIRED — Admin access control
# -----------------------------------------------------------------------------
# Comma-separated emails allowed to call admin API routes. Admin accounts must
# also be provisioned through a trusted Supabase/service-role process — signup
# metadata can never grant admin.
ADMIN_EMAIL_ALLOWLIST=admin@example.com


# -----------------------------------------------------------------------------
# 6. RECOMMENDED — App URLs & Social Previews
# -----------------------------------------------------------------------------
# Used for auth callbacks, share links, OpenGraph metadataBase, and crawler previews.
# In production (e.g. Vercel), set this to your live domain (https://acredia.io).
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# 7. RECOMMENDED — Verification audit log
# -----------------------------------------------------------------------------
# HMAC secret used to hash IPs/tokens in verification_logs (privacy-safe audit).
# Falls back to SUPABASE_SERVICE_ROLE_KEY when omitted — set a dedicated value
# in production.
VERIFICATION_LOG_HASH_SECRET=your_random_audit_hash_secret


# -----------------------------------------------------------------------------
# 8. REQUIRED IN PRODUCTION — Scheduled data retention
# -----------------------------------------------------------------------------
# Shared secret for /api/cron/* . Vercel Cron sends it automatically as
# `Authorization: Bearer $CRON_SECRET` once this is set on the project.
#
# Without it the nightly retention purge REFUSES TO RUN (the route fails
# closed rather than leaving a row-deleting endpoint open), and the retention
# periods published at /legal/privacy will not be enforced. Generate one with:
#     openssl rand -base64 32
CRON_SECRET=your_random_cron_secret

# Required when the daily credential TTL keeper is enabled. Fund this
# dedicated account on the configured network. Keep its secret server-only
# and separate from the hardware-held contract owner account.
TTL_KEEPER_ACCOUNT_PUBLIC=
TTL_KEEPER_ACCOUNT_SECRET=


# -----------------------------------------------------------------------------
# 9. OPTIONAL — Email notifications (Resend)
# -----------------------------------------------------------------------------
# Without this, the app runs normally and email sending is skipped with a warning.
# Requires a verified sending domain on the provider.
# RESEND_API_KEY=re_your_resend_api_key


# -----------------------------------------------------------------------------
# 10. REQUIRED IN PRODUCTION — Distributed rate limiting & cache (Upstash Redis)
# -----------------------------------------------------------------------------
# REQUIRED for production. Without these, rate limiting and the verification cache
# fall back to per-instance in-memory storage (fine for local dev, but acts as a
# security/abuse gap on serverless).
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Per-route overrides (optional): RATE_LIMIT_<PREFIX>_WINDOW_SECONDS / _MAX_REQUESTS
# RATE_LIMIT_VERIFY_WINDOW_SECONDS=60
# RATE_LIMIT_VERIFY_MAX_REQUESTS=10


# -----------------------------------------------------------------------------
# 11. OPTIONAL — Observability (errors + metrics ingest)
# -----------------------------------------------------------------------------
# Any endpoint that accepts JSON POSTs. Payloads are PII-scrubbed before sending.
# OBSERVABILITY_INGEST_URL=https://your-collector.example.com/ingest
# NEXT_PUBLIC_OBSERVABILITY_INGEST_URL=https://your-collector.example.com/ingest


# -----------------------------------------------------------------------------
# 12. OPTIONAL — Secondary IPFS pinning (redundancy keeper)
# -----------------------------------------------------------------------------
# A second pinning provider so losing one service can't orphan credentials.
# SECONDARY_PINNING_PROVIDER_NAME=web3storage
# SECONDARY_PINNING_ENDPOINT=https://api.web3.storage/pins
# SECONDARY_PINNING_TOKEN=your_secondary_pinning_token


# -----------------------------------------------------------------------------
# 13. OPTIONAL — Debug
# -----------------------------------------------------------------------------
# Verbose, PII-scrubbed logs. Ignored in production builds.
NEXT_PUBLIC_ENABLE_DEBUG_LOGS=false


# =============================================================================
# WALLETCONNECT  (optional, but the only way a phone can connect a wallet)
# =============================================================================
# Eight of the ten supported wallets are desktop browser extensions, so without
# this a mobile user has no wallet to connect (ACREDIA-STELLAR#4). With it, the
# student scans a QR with a wallet app (Lobstr, Hana) and signs there.
#
# Free project id from https://cloud.reown.com. Leave blank and the module is
# simply not registered — no broken entry in the wallet list, and mobile users
# get an honest explanation of their options instead.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Shown inside the student's wallet while they approve the session, so it must
# be your real origin — a placeholder here reads as a phishing attempt at the
# moment trust matters most. Already set above for metadata/sitemap use.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example


# =============================================================================
# SECURITY REMINDERS
#   • Never commit `.env.local`, paste secrets into issues/screenshots/chat, or
#     put a service-role key, Pinata JWT or Stellar SECRET key in NEXT_PUBLIC_*.
#   • Stellar secret keys (S...) belong in a wallet or secret manager — not here.
#   • Rotate any secret that has ever been shared or logged.
# =============================================================================
