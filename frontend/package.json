{
    "name": "frontend",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "vitest run tests/e2e.lifecycle.test.ts",
        "test:browser": "playwright test",
        "test:a11y": "playwright test tests/playwright/a11y.spec.ts",
        "test:load": "vitest run tests/load-endpoints.test.ts",
        "lint": "eslint .",
        "format": "prettier --write .",
        "indexer": "tsx --env-file=.env.local scripts/indexer.ts",
        "db:backup": "bash scripts/backup-db.sh",
        "db:restore": "bash scripts/restore-db.sh",
        "email-worker": "tsx --env-file=.env.local scripts/emailWorker.ts",
        "worker:pin-keeper": "tsx --env-file=.env.local worker/pinKeeper.ts",
        "db:schema": "bash scripts/build-schema.sh"
    },
    "dependencies": {
