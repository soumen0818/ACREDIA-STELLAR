        "dotenv": "^17.4.2",
        "eslint": "^10.9.1",
        "eslint-config-next": "^16.3.3",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "null-loader": "^4.0.1",
        "prettier": "^3.9.6",
