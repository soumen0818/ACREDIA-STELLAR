        "next": "^16.2.6",
        "next-themes": "^0.4.6",
        "papaparse": "^5.5.4",
        "qrcode": "^1.5.4",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "react-hook-form": "^7.77.0",
        "react-hot-toast": "^2.6.0",
